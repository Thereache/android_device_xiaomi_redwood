# Audio
get_prop(miui_camera_platform_domain, audio_config_prop)

allow miui_camera_platform_domain vendor_hal_soter_hwservice:hwservice_manager find;
allow miui_camera_platform_domain hal_misys_hwservice:hwservice_manager find;
binder_call(miui_camera_platform_domain, vendor_hal_soter_qti)
binder_call(miui_camera_platform_domain, hal_misys_default)

# Leica Camera
get_prop(miui_camera_platform_domain, vendor_display_prop)
get_prop(miui_camera_platform_domain, vendor_camera_sensor_prop)
allow miui_camera_platform_domain vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
binder_call(miui_camera_platform_domain, vendor_hal_camerapostproc_xiaomi)

# Incremental
get_prop(miui_camera_platform_domain, incremental_prop)
# To create files, get permission to fill blocks, and configure Incremental File System
allow miui_camera_platform_domain incremental_control_file:file { ioctl r_file_perms };
allowxperm miui_camera_platform_domain incremental_control_file:file ioctl {
  INCFS_IOCTL_CREATE_FILE
  INCFS_IOCTL_CREATE_MAPPED_FILE
  INCFS_IOCTL_PERMIT_FILL
  INCFS_IOCTL_GET_READ_TIMEOUTS
  INCFS_IOCTL_SET_READ_TIMEOUTS
  INCFS_IOCTL_GET_LAST_READ_ERROR
};
# To get signature of an APK installed on Incremental File System, and fill in data
# blocks and get the filesystem state
allowxperm miui_camera_platform_domain apk_data_file:file ioctl {
  INCFS_IOCTL_READ_SIGNATURE
  INCFS_IOCTL_FILL_BLOCKS
  INCFS_IOCTL_GET_FILLED_BLOCKS
  INCFS_IOCTL_GET_BLOCK_COUNT
  F2FS_IOC_GET_FEATURES
  F2FS_IOC_GET_COMPRESS_BLOCKS
  F2FS_IOC_COMPRESS_FILE
  F2FS_IOC_DECOMPRESS_FILE
  F2FS_IOC_RELEASE_COMPRESS_BLOCKS
  F2FS_IOC_RESERVE_COMPRESS_BLOCKS
  FS_IOC_SETFLAGS
  FS_IOC_GETFLAGS
};
