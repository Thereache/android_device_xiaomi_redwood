# Bluetooth
bluetooth.device_id.vendor_id=0x001D
persist.bluetooth.disableinbandringing=true
bluetooth.server.automatic_turn_on=true

# Blur
ro.launcher.blur.appLaunch=0

# Graphics
ro.surface_flinger.game_default_frame_rate_override=120

# IMS
ro.telephony.block_binder_thread_on_incoming_calls=false

# Radio
ro.telephony.call_ring.multiple=false
ro.telephony.default_cdma_sub=0
ro.telephony.default_network=26,26

# Seamless transfer
Seamless transfer

# LMK tuning
ro.lmk.swap_free_low_percentage=10
ro.lmk.swap_compression_ratio=3
ro.lmk.lowmem_min_oom_score=951
